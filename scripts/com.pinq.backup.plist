<?xml version="1.0" encoding="UTF-8"?>
<!--
  매일 PinQ 서버 백업. cron 이 아니라 launchd 인 이유:
  cron 은 맥이 잠들어 있던 시각의 실행을 그냥 건너뛴다. 노트북은 닫혀 있는
  시간이 많아 조용히 빠지는 날이 생긴다. launchd 는 놓친 실행을 깨어날 때
  한 번 돌려준다.

  설치:
    sed "s|__REPO__|$PWD|" scripts/com.pinq.backup.plist > ~/Library/LaunchAgents/com.pinq.backup.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pinq.backup.plist
  즉시 1회 실행:  launchctl kickstart -k gui/$(id -u)/com.pinq.backup
  중지:          launchctl bootout gui/$(id -u)/com.pinq.backup
  로그:          ~/backups/pinq/backup.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pinq.backup</string>

  <!-- zsh -lc: 로그인 셸을 거쳐야 PATH 에 docker/ssh 등이 잡힌다.
       launchd 의 기본 PATH 는 /usr/bin:/bin:/usr/sbin:/sbin 뿐이다. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>__REPO__/scripts/backup-fetch.sh</string>
  </array>

  <!-- 하루 세 번. 13시 한 번으로는 20일 중 7일만 성공했다(2026-08-24~09-12):
       잠든 사이 놓친 실행이 Wi-Fi 붙기 전에 돌거나, 사내망이 22번을 막는다.
       스크립트가 이미 성공한 날은 건너뛰므로 세 번 다 돌지 않는다. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>__HOME__/backups/pinq/backup.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/backups/pinq/backup.log</string>

  <!-- 로드하자마자 돌지 않게 한다. 실행은 위 시각에만. -->
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
